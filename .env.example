# Server
PORT=8000
NODE_ENV=development
# Comma-separated frontend origins allowed to call the API (needed for cookie-based auth from a browser)
CORS_ORIGIN=http://localhost:3000

# MongoDB (the database name "youtubeBackend" is added by the app)
MONGO_URI=mongodb://127.0.0.1:27017

# JWT
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-to-a-different-long-random-string
REFRESH_TOKEN_EXPIRES_IN=7d

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
